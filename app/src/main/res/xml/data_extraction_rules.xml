<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Keep in sync with SessionStore.FILE, AccountStore.FILE and EmberfinDatabase. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="emberfin_auth.xml" />
        <exclude domain="file" path="datastore/emberfin_accounts.preferences_pb" />
        <exclude domain="database" path="emberfin.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="emberfin_auth.xml" />
        <exclude domain="file" path="datastore/emberfin_accounts.preferences_pb" />
        <exclude domain="database" path="emberfin.db" />
    </device-transfer>
</data-extraction-rules>
