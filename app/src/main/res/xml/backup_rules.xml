<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Keep in sync with SessionStore.FILE, AccountStore.FILE and EmberfinDatabase. -->
<full-backup-content>
    <exclude domain="sharedpref" path="emberfin_auth.xml" />
    <exclude domain="file" path="datastore/emberfin_accounts.preferences_pb" />
    <exclude domain="database" path="emberfin.db" />
</full-backup-content>
